# =========================
# OS / editor noise
# =========================

.DS_Store
Thumbs.db
.vscode/
*.swp
*.tmp
*.log


# =========================
# Python
# =========================

.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd


# =========================
# Jupyter
# =========================

.ipynb_checkpoints/


# =========================
# Raw data downloads
# Never versioned
# =========================

raw/**/downloads/
raw/**/*.zip
raw/**/*.7z
raw/**/*.osm.pbf
raw/**/*.gpkg
raw/**/*.geojson
raw/**/*.shp
raw/**/*.shx
raw/**/*.dbf
raw/**/*.prj
raw/**/*.tif
raw/**/*.tiff
raw/**/*.nc
raw/**/*.csv


# =========================
# Processed data
# Default: ignore
# =========================

processed/**

# Allow traversal into city directories
!processed/*/


# =========================
# RTM priors
# =========================

!processed/RTM/priors/
!processed/RTM/priors/*.parquet

# Keep samples out
processed/RTM/priors/*_sample.parquet


# =========================
# Final processed pluvial hazard inputs
# Used by RTM / HAM / DON analyses
# =========================

!processed/*/hazards/
!processed/*/hazards/pluvial/

!processed/*/hazards/pluvial/H_pluvial_v1_buildings.parquet

# Allow documentation alongside final hazard products
!processed/*/hazards/pluvial/README.md
!processed/*/hazards/pluvial/metadata.*


# =========================
# City-level documentation / metadata
# =========================

!processed/*/README.md
!processed/*/metadata.*


# =========================
# Deprecated scripts
# =========================

scripts/rtm/hazards/pluvial/deprecated/